# ==============================================================================
# Online Food Ordering System - Environment Variables Configuration Template
# Copy this file to .env and provide your actual secrets/credentials.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# MongoDB Configuration
# For Local MongoDB: mongodb://localhost:27017/food_ordering_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/food_ordering_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/food_ordering_db

# JWT Configuration (Secret must be at least 256 bits / 32+ characters)
# Example secure key: 404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_SECRET=FoodOrderingSecretKeyMustBeAtLeast32BytesLongForHS256Security123456
JWT_EXPIRATION_MS=86400000

# Initial Admin Bootstrap Configuration
# If specified, the application will seed an ADMIN account on first startup if it does not already exist.
ADMIN_EMAIL=admin@foodordering.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=System Administrator
ADMIN_PHONE=1234567890
ADMIN_ADDRESS=Headquarters Restaurant St
