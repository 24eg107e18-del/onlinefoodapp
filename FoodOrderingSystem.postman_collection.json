{
  "info": {
    "name": "CraveBite - Online Food Ordering System API",
    "description": "Complete collection of RESTful APIs for customer ordering and admin management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health" }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"phone\": \"9876543210\",\n  \"address\": \"123 Park Avenue, Apt 4B\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register" }
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@foodordering.com\",\n  \"password\": \"AdminPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        }
      ]
    },
    {
      "name": "2. Food Catalog (Public)",
      "item": [
        {
          "name": "Get All Foods",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/foods" }
          }
        },
        {
          "name": "Search & Filter Foods",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/foods?search=pizza&available=true"
            }
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories?activeOnly=true" }
          }
        }
      ]
    },
    {
      "name": "3. Shopping Cart (Customer)",
      "item": [
        {
          "name": "View My Cart",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/cart" }
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodItemId\": \"<REPLACE_FOOD_ID>\",\n  \"quantity\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/cart/add" }
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/cart/<REPLACE_FOOD_ID>" }
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/cart/clear" }
          }
        }
      ]
    },
    {
      "name": "4. Orders (Customer)",
      "item": [
        {
          "name": "Place Order (Checkout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryAddress\": \"123 Park Avenue, Apt 4B\",\n  \"paymentMethod\": \"CASH_ON_DELIVERY\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders" }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/orders" }
          }
        },
        {
          "name": "Track Order by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/orders/<REPLACE_ORDER_ID>" }
          }
        }
      ]
    },
    {
      "name": "5. User Profile (Customer)",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/users/profile" }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice J. Smith\",\n  \"phone\": \"9876543210\",\n  \"address\": \"456 Elm Street, Suite 2A\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/profile" }
          }
        }
      ]
    },
    {
      "name": "6. Administration (Admin Role)",
      "item": [
        {
          "name": "Get Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/dashboard" }
          }
        },
        {
          "name": "Get All Restaurant Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/orders" }
          }
        },
        {
          "name": "Get Registered Customers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/users" }
          }
        },
        {
          "name": "Update Order Status (Fulfillment)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders/<REPLACE_ORDER_ID>/status" }
          }
        },
        {
          "name": "Create New Dish",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BBQ Chicken Pizza\",\n  \"description\": \"Smoky barbecue sauce, grilled chicken, red onions and cilantro\",\n  \"categoryId\": \"<REPLACE_CATEGORY_ID>\",\n  \"price\": 16.50,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1513104890138-7c749659a591\",\n  \"available\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/foods" }
          }
        }
      ]
    }
  ]
}
